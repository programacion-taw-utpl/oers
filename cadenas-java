        vars: [
          { name: "estudiante", type: "String", val: '"Pedro"', inputVal: "Pedro", kind: "text" },
          { name: "materia", type: "String", val: '"Programación"', inputVal: "Programación", kind: "text" },
          { name: "creditos", type: "int", val: "4", inputVal: 4, kind: "number" },
          { name: "calificacion", type: "double", val: "9.489", inputVal: 9.489, step: "0.001", kind: "number" },
