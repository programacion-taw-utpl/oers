<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Java String.format() Master - Juego Interactivo</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

  <script>
    // Configuración de colores institucionales UTPL para Tailwind
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            utpl: {
              blue: '#003F69',
              'blue-dark': '#002640',
              'blue-light': '#005b96',
              'blue-card': '#003456',
              'blue-subtle': '#004975',
              yellow: '#F9B200',
              'yellow-hover': '#e0a000',
              'yellow-dark': '#b37e00'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #002640;
    }
    .code-font {
      font-family: 'Fira Code', monospace;
    }
    .slot-box {
      min-width: 70px;
      min-height: 38px;
      border: 2px dashed #38bdf8;
      transition: all 0.25s ease;
    }
    .slot-box.drag-over {
      border-color: #F9B200;
      background-color: rgba(249, 178, 0, 0.2);
      transform: scale(1.05);
    }
    .slot-box.filled {
      border-style: solid;
      border-color: #F9B200;
      background-color: rgba(249, 178, 0, 0.15);
    }
    .slot-box.correct {
      border-color: #22c55e !important;
      background-color: rgba(34, 197, 94, 0.2) !important;
    }
    .slot-box.incorrect {
      border-color: #ef4444 !important;
      background-color: rgba(239, 68, 68, 0.2) !important;
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #002640;
    }
    ::-webkit-scrollbar-thumb {
      background: #004975;
      border-radius: 4px;
    }
  </style>
</head>
<body class="bg-utpl-blue-dark text-slate-100 min-h-screen flex flex-col antialiased selection:bg-utpl-yellow selection:text-utpl-blue-dark">

  <!-- BARRA DE NAVEGACIÓN SUPERIOR (Paleta UTPL) -->
  <header class="bg-utpl-blue border-b border-utpl-blue-light/50 sticky top-0 z-50 px-4 py-3 shadow-lg">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-utpl-yellow flex items-center justify-center shadow-md shadow-utpl-yellow/20">
          <i class="fa-brands fa-java text-utpl-blue-dark font-extrabold text-2xl"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold text-white flex items-center gap-2">
            Taller Evaluativo: Java String.format()
            <span class="text-xs bg-utpl-yellow text-utpl-blue-dark font-black px-2 py-0.5 rounded-full uppercase tracking-wider">UTPL</span>
          </h1>
          <p class="text-xs text-blue-200/80 font-medium">Clase 05 — Introducción a la Programación (Niveles 1 al 6)</p>
        </div>
      </div>

      <!-- Navegación por pestañas con estilo UTPL -->
      <nav class="flex space-x-1 bg-utpl-blue-dark/80 p-1.5 rounded-xl border border-utpl-blue-light/40 text-sm">
        <button onclick="switchTab('activity-tab')" id="tab-btn-activity" class="tab-btn px-4 py-1.5 rounded-lg font-bold transition-all duration-200 bg-utpl-yellow text-utpl-blue-dark shadow-sm flex items-center gap-2">
          <i class="fa-solid fa-layer-group"></i> Niveles de Práctica
        </button>
        <button onclick="switchTab('cheatsheet-tab')" id="tab-btn-cheatsheet" class="tab-btn px-4 py-1.5 rounded-lg font-semibold transition-all duration-200 text-blue-200 hover:text-white hover:bg-utpl-blue flex items-center gap-2">
          <i class="fa-solid fa-book-bookmark"></i> Chuleta de Formato
        </button>
      </nav>
    </div>
  </header>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 flex flex-col gap-6">

    <!-- ==================== PESTAÑA PRINCIPAL: NIVELES 1 AL 6 ==================== -->
    <section id="activity-tab" class="tab-content flex-1 flex flex-col gap-6">

      <!-- Barra de Selector de Nivel (1 al 6) y Certificado con Azul UTPL -->
      <div class="bg-gradient-to-r from-utpl-blue to-utpl-blue-card border border-utpl-blue-light/60 rounded-2xl p-4 sm:p-5 shadow-lg flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-utpl-yellow font-bold text-xs tracking-wider uppercase mb-1">
            <span class="w-2 h-2 rounded-full bg-utpl-yellow animate-ping"></span>
            Progreso de la Práctica
          </div>
          <h2 id="current-level-heading" class="text-lg sm:text-xl font-bold text-white">Nivel 1 de 6</h2>
        </div>

        <!-- Indicadores de los 6 Niveles -->
        <div class="flex items-center gap-2 flex-wrap">
          <button onclick="goToLevel(0)" id="lvl-nav-0" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-yellow bg-utpl-yellow text-utpl-blue-dark">1</button>
          <button onclick="goToLevel(1)" id="lvl-nav-1" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200">2</button>
          <button onclick="goToLevel(2)" id="lvl-nav-2" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200">3</button>
          <button onclick="goToLevel(3)" id="lvl-nav-3" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200">4</button>
          <button onclick="goToLevel(4)" id="lvl-nav-4" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200">5</button>
          <button onclick="goToLevel(5)" id="lvl-nav-5" class="w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200">6</button>
          <button onclick="goToReport()" id="lvl-nav-report" class="px-3 h-9 rounded-xl font-bold text-xs flex items-center gap-1.5 transition border border-utpl-yellow/60 bg-utpl-blue-dark text-utpl-yellow hover:bg-utpl-yellow hover:text-utpl-blue-dark">
            <i class="fa-solid fa-graduation-cap"></i> Finalizar y Certificar
          </button>
        </div>
      </div>

      <!-- Contenedor del Nivel Activo (Editor + Laboratorio Integrado) -->
      <div id="level-play-area" class="space-y-6">
        
        <!-- Enunciado del Nivel -->
        <div class="bg-utpl-blue border border-utpl-blue-light/50 rounded-2xl p-5 shadow-md">
          <h3 id="level-title" class="text-xl font-bold text-white mb-1 flex items-center gap-2">
            <i class="fa-solid fa-code text-utpl-yellow"></i> Nivel 1: Construcción Básica (%s, %d)
          </h3>
          <p id="level-instruction" class="text-sm text-blue-100">
            Aprende a combinar un texto y un valor entero respetando el orden posicional de los argumentos en String.format().
          </p>
        </div>

        <!-- Panel de Desafío y Laboratorio en 2 Columnas -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          
          <!-- Columna Izquierda (8 cols): Editor Interactivo de Desafío -->
          <div class="lg:col-span-8 bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl shadow-xl overflow-hidden flex flex-col">
            <div class="bg-utpl-blue-dark px-4 py-3 border-b border-utpl-blue-light/40 flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-utpl-yellow inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
                <span id="level-filename" class="ml-2 text-xs text-blue-200 code-font">EjercicioNivel1.java</span>
              </div>
              <span id="level-status-pill" class="text-xs px-2.5 py-0.5 rounded-full font-bold bg-utpl-yellow/20 text-utpl-yellow border border-utpl-yellow/40">
                Pendiente de resolver
              </span>
            </div>

            <div class="p-5 sm:p-6 code-font text-sm leading-relaxed overflow-x-auto space-y-4">
              <!-- Variables del Nivel -->
              <div class="bg-utpl-blue-dark/80 p-4 rounded-xl border border-utpl-blue-light/30">
                <div class="text-xs text-blue-300 uppercase font-bold tracking-wider mb-2 font-sans flex items-center gap-2">
                  <i class="fa-solid fa-memory text-utpl-yellow"></i> Variables declaradas en memoria:
                </div>
                <div id="level-variables" class="space-y-1 text-slate-200"></div>
              </div>

              <!-- Plantilla interactiva con ranuras -->
              <div class="bg-utpl-blue/40 p-5 rounded-xl border border-utpl-blue-light/50">
                <p class="text-xs text-blue-200 mb-2 font-sans flex items-center gap-1.5">
                  <i class="fa-solid fa-hand-pointer text-utpl-yellow"></i> Completa los especificadores en la plantilla:
                </p>
                <div class="text-slate-100 flex flex-wrap items-center gap-2" id="level-template-area"></div>
              </div>

              <div class="text-xs sm:text-sm pl-2">
                <span class="text-blue-200 font-bold font-sans">Argumentos pasados a format:</span>
                <span id="level-args" class="text-utpl-yellow font-bold ml-2"></span>
              </div>

              <!-- Consola de salida esperada -->
              <div class="pt-2">
                <div class="text-xs text-blue-300 mb-1 flex items-center justify-between font-sans font-medium">
                  <span><i class="fa-solid fa-terminal text-utpl-yellow mr-1"></i> Salida que debe producir Java:</span>
                </div>
                <div id="level-expected-output" class="bg-black/70 p-3 rounded-xl border border-utpl-blue-light/40 text-emerald-300 text-xs sm:text-sm"></div>
              </div>
            </div>

            <!-- Botones de Acción del Desafío con botón UTPL amarillo -->
            <div class="bg-utpl-blue-dark px-6 py-4 border-t border-utpl-blue-light/40 flex flex-wrap items-center justify-between gap-4">
              <button onclick="clearCurrentSlots()" class="px-4 py-2 rounded-xl text-blue-200 hover:text-white bg-utpl-blue hover:bg-utpl-blue-light/60 font-semibold text-xs sm:text-sm transition flex items-center gap-2 border border-utpl-blue-light/30">
                <i class="fa-solid fa-arrow-rotate-left"></i> Limpiar Huecos
              </button>

              <button onclick="validateCurrentLevel()" id="btn-validate" class="px-6 py-2.5 rounded-xl bg-utpl-yellow hover:bg-utpl-yellow-hover text-utpl-blue-dark font-extrabold text-sm shadow-lg shadow-utpl-yellow/20 transition transform active:scale-95 flex items-center gap-2">
                <i class="fa-solid fa-check-double"></i> Validar Solución
              </button>
            </div>
          </div>

          <!-- Columna Derecha (4 cols): Fichas + Laboratorio Dinámico del Nivel -->
          <div class="lg:col-span-4 flex flex-col gap-6">
            
            <!-- Fichas disponibles -->
            <div class="bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl p-5 shadow-xl">
              <h4 class="font-bold text-white text-sm flex items-center justify-between mb-2">
                <span><i class="fa-solid fa-puzzle-piece text-utpl-yellow mr-2"></i> Fichas del Nivel</span>
                <span class="text-[11px] text-blue-200 font-medium">Clic o Arrastrar</span>
              </h4>
              <p class="text-xs text-blue-200/80 mb-3">Toca una ficha para asignarla al primer hueco disponible:</p>
              <div id="level-tokens-dock" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Laboratorio en tiempo real del Nivel -->
            <div class="bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl p-5 shadow-xl">
              <h4 class="font-bold text-white text-sm flex items-center gap-2 mb-2">
                <i class="fa-solid fa-flask-vial text-utpl-yellow"></i> Laboratorio del Nivel
              </h4>
              <p class="text-xs text-blue-200/80 mb-3">
                Edita los valores en vivo para observar cómo reacciona Java y cómo cambia la salida:
              </p>

              <div id="level-sandbox-controls" class="space-y-3 text-xs"></div>

              <!-- Salida de prueba en vivo -->
              <div class="mt-4 pt-3 border-t border-utpl-blue-light/30">
                <span class="text-[11px] font-semibold text-blue-300 uppercase tracking-wider block mb-1">
                  Vista previa de la salida generada:
                </span>
                <div id="level-sandbox-preview" class="p-3 bg-black/60 rounded-xl border border-utpl-blue-light/40 text-utpl-yellow code-font text-xs min-h-[48px] break-all font-semibold"></div>
              </div>
            </div>

            <!-- Retroalimentación pedagógica -->
            <div id="level-feedback-box" class="bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl p-4 text-xs text-blue-100">
              <div class="flex items-start gap-2.5">
                <i class="fa-solid fa-circle-info text-utpl-yellow text-base mt-0.5"></i>
                <div id="level-feedback-text">
                  Observa atentamente los tipos de datos de las variables declaradas arriba para escoger los especificadores precisos.
                </div>
              </div>
            </div>

            <!-- Botón Nivel Siguiente con estilo UTPL -->
            <button id="btn-next-level" onclick="goNextLevel()" class="hidden w-full py-3 px-4 bg-utpl-yellow hover:bg-utpl-yellow-hover text-utpl-blue-dark font-extrabold rounded-xl shadow-lg shadow-utpl-yellow/25 transition transform active:scale-95 flex items-center justify-center gap-2 text-sm animate-pulse">
              <span>Continuar al Siguiente Nivel</span>
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>

      </div>

      <!-- ==================== PANTALLA FINAL: CERTIFICACIÓN Y EVALUACIÓN ==================== -->
      <div id="final-report-area" class="hidden bg-utpl-blue-card border border-utpl-blue-light/50 rounded-2xl p-6 sm:p-8 shadow-2xl max-w-4xl mx-auto w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="w-16 h-16 rounded-2xl bg-utpl-yellow flex items-center justify-center mx-auto mb-3 shadow-lg shadow-utpl-yellow/25 text-3xl text-utpl-blue-dark">
            <i class="fa-solid fa-award"></i>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Registro y Certificado de Práctica</h2>
          <p class="text-sm text-blue-200 mt-2">
            Ingresa tus datos personales y tu usuario de GitHub para generar tu hoja de reporte y calificar tu desempeño en la Clase 05.
          </p>
        </div>

        <!-- Formulario del Estudiante -->
        <div class="bg-utpl-blue-dark p-6 rounded-2xl border border-utpl-blue-light/40 mb-6">
          <h4 class="text-sm font-bold text-utpl-yellow uppercase tracking-wider mb-4 flex items-center gap-2">
            <i class="fa-solid fa-id-card"></i> Datos del Estudiante
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-blue-200 mb-1">Nombre Completo:</label>
              <input type="text" id="student-name" placeholder="Ej. Juan Carlos Pérez" oninput="updateCertificate()" class="w-full bg-utpl-blue border border-utpl-blue-light rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-utpl-yellow">
            </div>
            <div>
              <label class="block text-xs font-semibold text-blue-200 mb-1">Usuario de GitHub:</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-blue-300">
                  <i class="fa-brands fa-github"></i>
                </span>
                <input type="text" id="student-github" placeholder="Ej. juanperez-dev" oninput="updateCertificate()" class="w-full bg-utpl-blue border border-utpl-blue-light rounded-xl pl-9 pr-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-utpl-yellow">
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta del Certificado Generado con Identidad UTPL -->
        <div id="certificate-card" class="bg-gradient-to-b from-utpl-blue-dark via-utpl-blue-card to-utpl-blue border-2 border-utpl-yellow/70 rounded-2xl p-6 sm:p-8 relative overflow-hidden shadow-2xl">
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-utpl-blue-light/40">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-utpl-yellow flex items-center justify-center font-black text-utpl-blue-dark text-xl">
                UTPL
              </div>
              <div>
                <h3 class="text-lg font-bold text-white">Certificado de Aprobación de Práctica</h3>
                <p class="text-xs text-blue-200">Universidad Técnica Particular de Loja &bull; Introducción a la Programación</p>
              </div>
            </div>
            <div class="text-right bg-utpl-blue-dark/70 px-4 py-2 rounded-xl border border-utpl-blue-light/40">
              <span class="text-xs text-blue-300 uppercase block font-semibold">Calificación Obtenida</span>
              <span id="cert-score" class="text-3xl font-extrabold text-utpl-yellow code-font">10.0 / 10.0</span>
            </div>
          </div>

          <div class="py-6 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div class="p-3 bg-utpl-blue-dark/70 rounded-xl border border-utpl-blue-light/30">
                <span class="text-xs text-blue-300 block mb-0.5">Estudiante:</span>
                <span id="cert-student-name" class="font-bold text-white text-base">---</span>
              </div>
              <div class="p-3 bg-utpl-blue-dark/70 rounded-xl border border-utpl-blue-light/30">
                <span class="text-xs text-blue-300 block mb-0.5">Usuario GitHub:</span>
                <span id="cert-student-github" class="font-bold text-utpl-yellow font-mono text-base">@---</span>
              </div>
            </div>

            <!-- Desglose de Niveles Completados -->
            <div class="bg-utpl-blue-dark/50 p-4 rounded-xl border border-utpl-blue-light/30">
              <h5 class="text-xs font-bold text-blue-200 uppercase tracking-wider mb-2">Desglose de los 6 Niveles:</h5>
              <div id="levels-summary-list" class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
                <!-- Se llena dinámicamente con JS -->
              </div>
            </div>

            <div class="text-xs text-blue-200/90 bg-utpl-blue-dark/60 p-3 rounded-xl border border-utpl-blue-light/30">
              <strong class="text-white">Competencias evaluadas:</strong> Dominio de especificadores (<code class="text-utpl-yellow font-bold">%s</code>, <code class="text-utpl-yellow font-bold">%d</code>, <code class="text-utpl-yellow font-bold">%.2f</code>, <code class="text-utpl-yellow font-bold">%c</code>, <code class="text-utpl-yellow font-bold">%b</code>, <code class="text-utpl-yellow font-bold">%%</code>), concordancia de tipos, orden estricto de variables y principio de no-mutabilidad de variables en Java.
            </div>
          </div>

          <div class="pt-4 border-t border-utpl-blue-light/40 flex flex-wrap items-center justify-between gap-3 text-xs text-blue-300">
            <span id="cert-date">Fecha de emisión: --/--/----</span>
            <span class="font-mono text-utpl-yellow">Hash: UTPL-CLASE05-STRFORMAT</span>
          </div>
        </div>

        <!-- Botones de Acción Final con color UTPL -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <button onclick="goToLevel(0)" class="px-5 py-2.5 rounded-xl text-blue-200 hover:text-white bg-utpl-blue hover:bg-utpl-blue-light font-semibold text-xs sm:text-sm transition flex items-center gap-2 border border-utpl-blue-light/40">
            <i class="fa-solid fa-arrow-rotate-left"></i> Repasar desde el Nivel 1
          </button>
          <button onclick="copyCertificateReport()" class="px-6 py-2.5 rounded-xl bg-utpl-yellow hover:bg-utpl-yellow-hover text-utpl-blue-dark font-extrabold text-sm shadow-lg shadow-utpl-yellow/25 transition flex items-center gap-2">
            <i class="fa-regular fa-clipboard"></i> Copiar Resumen para Envío
          </button>
        </div>
      </div>

    </section>

    <!-- ==================== PESTAÑA: CHULETA DE ESPECIFICADORES (ESTILO UTPL) ==================== -->
    <section id="cheatsheet-tab" class="tab-content hidden flex-1 flex flex-col gap-6">
      <div class="bg-utpl-blue border border-utpl-blue-light/50 rounded-2xl p-5 shadow-lg">
        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-book-bookmark text-utpl-yellow"></i> Tabla Maestra de Especificadores
        </h2>
        <p class="text-blue-200 text-sm mt-1">
          Guía de consulta rápida basada en el contenido oficial de la Clase 05.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl p-4">
          <div class="flex items-center justify-between mb-2">
            <span class="code-font text-lg font-bold text-utpl-yellow bg-utpl-blue-dark px-2.5 py-1 rounded-lg border border-utpl-yellow/30">%s</span>
            <span class="text-xs text-blue-200 font-semibold">Cadena (String)</span>
          </div>
          <p class="text-xs text-blue-100 mb-2">Representa texto o cualquier dato convertido a cadena.</p>
          <div class="bg-utpl-blue-dark p-2.5 rounded text-xs code-font text-emerald-300 border border-utpl-blue-light/20">
            String.format("Hola %s", "Luis") &rarr; "Hola Luis"
          </div>
        </div>

        <div class="bg-utpl-blue-card border border-utpl-blue-light/40 rounded-2xl p-4">
          <div class="flex items-center justify-between mb-2">
            <span class="code-font text-lg font-bold text-utpl-yellow bg-utpl-blue-dark px-2.5 py-1 rounded-lg border border-utpl-yellow/30">%d</span>
            <span class="text-xs text-blue-200 font-semibold">Entero (int, long)</span>
          </div>
          <p class="text-xs text-blue-100 mb-2">Decimal integer. No admite números con punto decimal.</p>
          <div class="bg-utpl-blue-dark p-2.5 rounded text-xs code-font text-emerald-300 border border-utpl-blue-light/20">
            String.format("Edad: %d", 20) &rarr; "Edad: 20"
          </div>
