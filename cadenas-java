    // Estado del taller
    let currentLevelIndex = 0;
    let completedLevels = [false, false, false, false, false, false];
    let levelAttempts = [0, 0, 0, 0, 0, 0];
    let currentSlots = [];
    let sandboxValues = {};

    window.onload = function() {
      loadLevel(0);
      updateCertDate();
    };

    function switchTab(tabId) {
      sound.click();
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(tabId).classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-utpl-yellow', 'text-utpl-blue-dark', 'shadow-sm', 'font-bold');
        btn.classList.add('text-blue-200');
      });

      const activeBtn = tabId === 'activity-tab' ? document.getElementById('tab-btn-activity') : document.getElementById('tab-btn-cheatsheet');
      if (activeBtn) {
        activeBtn.classList.remove('text-blue-200');
        activeBtn.classList.add('bg-utpl-yellow', 'text-utpl-blue-dark', 'shadow-sm', 'font-bold');
      }
    }

    function goToLevel(index) {
      sound.click();
      document.getElementById('level-play-area').classList.remove('hidden');
      document.getElementById('final-report-area').classList.add('hidden');
      loadLevel(index);
    }

    function goToReport() {
      sound.click();
      document.getElementById('level-play-area').classList.add('hidden');
      document.getElementById('final-report-area').classList.remove('hidden');
      updateCertificate();
    }

    function updateNavButtons() {
      for (let i = 0; i < 6; i++) {
        const btn = document.getElementById(`lvl-nav-${i}`);
        if (!btn) continue;

        if (i === currentLevelIndex) {
          btn.className = 'w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-utpl-yellow bg-utpl-yellow text-utpl-blue-dark ring-2 ring-utpl-yellow/40';
        } else if (completedLevels[i]) {
          btn.className = 'w-9 h-9 rounded-xl font-extrabold text-xs flex items-center justify-center transition border border-emerald-400 bg-emerald-600 text-white';
        } else {
          btn.className = 'w-9 h-9 rounded-xl font-bold text-xs flex items-center justify-center transition border border-utpl-blue-light/40 bg-utpl-blue-dark text-blue-200';
        }
      }
    }

    function loadLevel(index) {
      currentLevelIndex = index;
      const level = levelsData[index];
      currentSlots = new Array(level.solution.length).fill(null);
      sandboxValues = {};

      document.getElementById('current-level-heading').textContent = `Nivel ${index + 1} de 6`;
      document.getElementById('level-title').innerHTML = `<i class="fa-solid fa-code text-utpl-yellow"></i> ${level.title}`;
      document.getElementById('level-instruction').textContent = level.instruction;
      document.getElementById('level-filename').textContent = level.filename;

      const statusPill = document.getElementById('level-status-pill');
      if (completedLevels[index]) {
        statusPill.textContent = "Completado";
        statusPill.className = "text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-900/60 text-emerald-300 border border-emerald-500/50";
      } else {
        statusPill.textContent = "Pendiente de resolver";
        statusPill.className = "text-xs px-2.5 py-0.5 rounded-full font-bold bg-utpl-yellow/20 text-utpl-yellow border border-utpl-yellow/40";
      }

      // Renderizar variables
      const varsContainer = document.getElementById('level-variables');
      varsContainer.innerHTML = level.vars.map(v => `
        <div>
          <span class="text-sky-300 font-semibold">${v.type}</span>
          <span class="text-utpl-yellow font-bold">${v.name}</span> =
          <span class="text-amber-200">${v.val}</span>;
        </div>
      `).join('');

      document.getElementById('level-args').textContent = level.args.join(', ');
      document.getElementById('level-expected-output').textContent = `> ${level.expected}`;

      // Reconstruir plantilla
      const templateArea = document.getElementById('level-template-area');
      templateArea.innerHTML = '';

      const prefix = document.createElement('span');
      prefix.className = 'text-sky-300 font-bold';
      prefix.innerHTML = 'String <span class="text-white">mensaje</span> = <span class="text-utpl-yellow">String</span>.<span class="text-blue-200">format</span>(';
      templateArea.appendChild(prefix);

      for (let i = 0; i < level.parts.length; i++) {
        const textSpan = document.createElement('span');
        textSpan.className = 'text-amber-100 font-medium';
        textSpan.textContent = level.parts[i];
        templateArea.appendChild(textSpan);

        if (i < level.solution.length) {
          const slot = document.createElement('div');
          slot.id = `lvl-slot-${i}`;
          slot.className = 'slot-box inline-flex items-center justify-center px-3 py-1 rounded-lg bg-utpl-blue-dark/90 text-utpl-yellow font-bold cursor-pointer border border-dashed border-sky-400 hover:border-utpl-yellow transition';
          slot.innerHTML = '<span class="text-blue-300/60 text-xs font-mono">[ ... ]</span>';

          slot.ondragover = (e) => {
            e.preventDefault();
            slot.classList.add('drag-over');
          };
          slot.ondragleave = () => slot.classList.remove('drag-over');
          slot.ondrop = (e) => {
            e.preventDefault();
            slot.classList.remove('drag-over');
            const token = e.dataTransfer.getData('text/plain');
            assignTokenToSlot(i, token);
          };

          slot.onclick = () => {
            if (currentSlots[i]) {
              sound.click();
              removeTokenFromSlot(i);
            }
          };

          templateArea.appendChild(slot);
        }
      }

      const suffix = document.createElement('span');
      suffix.className = 'text-white';
      suffix.innerHTML = `, ${level.args.join(', ')});`;
      templateArea.appendChild(suffix);

      // Fichas
      renderDockTokens(level.tokens);

      // Laboratorio en vivo del nivel
      buildLevelSandbox(level);

      // Botón Siguiente
      document.getElementById('btn-next-level').classList.add('hidden');
      document.getElementById('btn-validate').classList.remove('hidden');

      // Reset feedback
      document.getElementById('level-feedback-text').innerHTML =
        "Arrastra o haz clic en los especificadores para colocarlos en los huecos en el orden exacto que exigen los argumentos.";

      updateNavButtons();
    }

    function renderDockTokens(tokens) {
      const dock = document.getElementById('level-tokens-dock');
      dock.innerHTML = '';
      tokens.forEach(tok => {
        const chip = document.createElement('div');
        chip.draggable = true;
        chip.className = 'px-3 py-1.5 rounded-xl bg-utpl-blue-dark hover:bg-utpl-yellow hover:text-utpl-blue-dark text-utpl-yellow font-bold code-font text-xs sm:text-sm cursor-grab active:cursor-grabbing border border-utpl-blue-light/50 shadow-sm transition select-none';
        chip.textContent = tok;

        chip.ondragstart = (e) => {
          sound.click();
          e.dataTransfer.setData('text/plain', tok);
        };

        chip.onclick = () => {
          sound.click();
          const firstEmpty = currentSlots.findIndex(val => val === null);
          if (firstEmpty !== -1) {
            assignTokenToSlot(firstEmpty, tok);
          } else {
            showModal(false, "Todos los huecos ya tienen ficha. Haz clic en uno de ellos si deseas cambiarla.");
          }
        };

        dock.appendChild(chip);
      });
    }

    function assignTokenToSlot(slotIndex, token) {
      currentSlots[slotIndex] = token;
      const el = document.getElementById(`lvl-slot-${slotIndex}`);
      el.className = 'slot-box filled inline-flex items-center justify-center px-3 py-1 rounded-lg bg-utpl-yellow/20 text-utpl-yellow font-bold cursor-pointer border border-utpl-yellow shadow-inner';
      el.innerHTML = `<span class="code-font text-utpl-yellow">${token}</span>`;
      sound.click();
    }

    function removeTokenFromSlot(slotIndex) {
      currentSlots[slotIndex] = null;
      const el = document.getElementById(`lvl-slot-${slotIndex}`);
      el.className = 'slot-box inline-flex items-center justify-center px-3 py-1 rounded-lg bg-utpl-blue-dark/90 text-utpl-yellow font-bold cursor-pointer border border-dashed border-sky-400 hover:border-utpl-yellow';
      el.innerHTML = '<span class="text-blue-300/60 text-xs font-mono">[ ... ]</span>';
    }

    function clearCurrentSlots() {
      sound.click();
      currentSlots.forEach((_, idx) => removeTokenFromSlot(idx));
    }

    function validateCurrentLevel() {
      const level = levelsData[currentLevelIndex];
      levelAttempts[currentLevelIndex]++;

      if (currentSlots.some(s => s === null)) {
        sound.error();
        showModal(false, "Debes completar todos los huecos con especificadores antes de validar.");
        return;
      }

      let correct = true;
      for (let i = 0; i < level.solution.length; i++) {
        const slotEl = document.getElementById(`lvl-slot-${i}`);
        if (currentSlots[i] === level.solution[i]) {
          slotEl.classList.remove('incorrect');
          slotEl.classList.add('correct');
        } else {
          slotEl.classList.remove('correct');
          slotEl.classList.add('incorrect');
          correct = false;
        }
      }

      if (correct) {
        sound.success();
        completedLevels[currentLevelIndex] = true;
        updateNavButtons();

        document.getElementById('level-status-pill').textContent = "Completado";
        document.getElementById('level-status-pill').className = "text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-900/60 text-emerald-300 border border-emerald-500/50";

        document.getElementById('level-feedback-text').innerHTML =
          `<strong class="text-emerald-300">¡Nivel superado con éxito!</strong> La plantilla ha generado con exactitud:<br><span class="code-font text-utpl-yellow mt-1 block">${level.expected}</span>`;

        document.getElementById('btn-validate').classList.add('hidden');

        if (currentLevelIndex < 5) {
          document.getElementById('btn-next-level').classList.remove('hidden');
        } else {
          showModal(true, "¡Has completado todos los 6 niveles! Ahora puedes pasar a generar tu Certificado con tu Nombre y Usuario de GitHub.");
          goToReport();
        }
      } else {
        sound.error();
        document.getElementById('level-feedback-text').innerHTML =
          `<strong class="text-red-400">Error de compatibilidad u orden:</strong> Revisa la correspondencia entre los tipos de las variables declaradas y los especificadores ingresados.`;
      }
    }

    function goNextLevel() {
      if (currentLevelIndex < 5) {
        goToLevel(currentLevelIndex + 1);
      } else {
        goToReport();
      }
    }

    // ==================== LABORATORIO ESPECÍFICO DEL NIVEL ====================
    function buildLevelSandbox(level) {
      const controls = document.getElementById('level-sandbox-controls');
      controls.innerHTML = '';

      level.vars.forEach((v) => {
        sandboxValues[v.name] = v.inputVal;

        const row = document.createElement('div');
        row.className = 'flex flex-col gap-1';

        const label = document.createElement('label');
        label.className = 'text-[11px] font-semibold text-blue-200 flex items-center justify-between';
        label.innerHTML = `<span>${v.name} (<span class="text-utpl-yellow font-mono">${v.type}</span>):</span>`;
        row.appendChild(label);

        if (v.kind === 'bool') {
          const select = document.createElement('select');
          select.className = 'w-full bg-utpl-blue-dark border border-utpl-blue-light/50 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:border-utpl-yellow font-mono';
          select.innerHTML = '<option value="true">true</option><option value="false">false</option>';
          select.value = v.inputVal.toString();
          select.onchange = (e) => {
            sandboxValues[v.name] = (e.target.value === 'true');
            refreshLevelSandboxPreview(level);
          };
          row.appendChild(select);
        } else if (v.kind === 'char') {
          const input = document.createElement('input');
          input.type = 'text';
          input.maxLength = 1;
          input.value = v.inputVal;
          input.className = 'w-full bg-utpl-blue-dark border border-utpl-blue-light/50 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:border-utpl-yellow font-mono';
          input.oninput = (e) => {
            sandboxValues[v.name] = e.target.value || ' ';
            refreshLevelSandboxPreview(level);
          };
          row.appendChild(input);
        } else {
          const input = document.createElement('input');
          input.type = v.kind === 'number' ? 'number' : 'text';
          if (v.step) input.step = v.step;
          input.value = v.inputVal;
          input.className = 'w-full bg-utpl-blue-dark border border-utpl-blue-light/50 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:border-utpl-yellow font-mono';
          input.oninput = (e) => {
            sandboxValues[v.name] = v.kind === 'number' ? (parseFloat(e.target.value) || 0) : e.target.value;
            refreshLevelSandboxPreview(level);
          };
          row.appendChild(input);
        }

        controls.appendChild(row);
      });

      refreshLevelSandboxPreview(level);
    }

    function refreshLevelSandboxPreview(level) {
      const preview = document.getElementById('level-sandbox-preview');
      let out = level.labTemplate;

      level.args.forEach(argName => {
        const val = sandboxValues[argName];
        if (typeof val === 'number') {
          if (out.includes('%.2f')) {
            out = out.replace('%.2f', val.toFixed(2));
          } else if (out.includes('%.1f')) {
            out = out.replace('%.1f', val.toFixed(1));
          } else if (out.includes('%d')) {
            out = out.replace('%d', Math.round(val));
          } else if (out.includes('%f')) {
            out = out.replace('%f', val.toFixed(6));
          }
        } else if (typeof val === 'boolean') {
          out = out.replace('%b', val.toString());
        } else {
          if (out.includes('%c')) {
            out = out.replace('%c', String(val).charAt(0));
          } else {
            out = out.replace('%s', String(val));
          }
        }
      });

      out = out.replace('%%', '%');
      preview.textContent = `> ${out}`;
    }

    // ==================== REPORTE FINAL Y CERTIFICACIÓN ====================
    function updateCertDate() {
      const now = new Date();
      const dateStr = now.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
      document.getElementById('cert-date').textContent = `Fecha de emisión: ${dateStr}`;
    }

    function updateCertificate() {
      const name = document.getElementById('student-name').value.trim() || 'Estudiante';
      const github = document.getElementById('student-github').value.trim() || 'usuario-github';

      document.getElementById('cert-student-name').textContent = name;
      document.getElementById('cert-student-github').textContent = `@${github.replace(/^@/, '')}`;

      // Cálculo de la nota sobre 10
      const totalCompleted = completedLevels.filter(Boolean).length;
      const scoreOutOf10 = ((totalCompleted / 6) * 10).toFixed(1);
      const certScore = document.getElementById('cert-score');
      certScore.textContent = `${scoreOutOf10} / 10.0`;

      if (totalCompleted === 6) {
        certScore.className = "text-3xl font-extrabold text-utpl-yellow code-font";
      } else if (totalCompleted >= 4) {
        certScore.className = "text-3xl font-extrabold text-amber-300 code-font";
      } else {
        certScore.className = "text-3xl font-extrabold text-red-400 code-font";
      }

      // Desglose de niveles
      const summaryList = document.getElementById('levels-summary-list');
      summaryList.innerHTML = '';
      levelsData.forEach((lvl, idx) => {
        const item = document.createElement('div');
        const done = completedLevels[idx];
        item.className = `p-2 rounded-lg border flex items-center justify-between ${
          done ? 'bg-utpl-blue border-utpl-yellow/60 text-utpl-yellow' : 'bg-utpl-blue-dark border-utpl-blue-light/30 text-blue-300/40'
        }`;
        item.innerHTML = `
          <span class="font-medium">Nivel ${idx + 1}</span>
          <i class="fa-solid ${done ? 'fa-circle-check text-utpl-yellow' : 'fa-circle-xmark text-blue-300/30'}"></i>
        `;
        summaryList.appendChild(item);
      });
    }

    function copyCertificateReport() {
      const name = document.getElementById('student-name').value.trim();
      const github = document.getElementById('student-github').value.trim();

      if (!name || !github) {
        showModal(false, "Por favor completa tu Nombre y tu Usuario de GitHub antes de copiar el reporte.");
        return;
      }

      const totalCompleted = completedLevels.filter(Boolean).length;
      const score = ((totalCompleted / 6) * 10).toFixed(1);

      const reportText = [
        "==================================================",
        "UNIVERSIDAD TÉCNICA PARTICULAR DE LOJA (UTPL)",
        "REPORTE DE PRÁCTICA: JAVA String.format()",
        "Clase 05 - Introducción a la Programación",
        "==================================================",
        `Estudiante     : ${name}`,
        `GitHub         : https://github.com/${github.replace(/^@/, '')}`,
        `Calificación   : ${score} / 10.0`,
        `Niveles listos : ${totalCompleted} de 6`,
        "--------------------------------------------------",
        "Desglose por niveles:",
        ...levelsData.map((l, i) => `  - Nivel ${i + 1} (${l.filename}): ${completedLevels[i] ? 'SUPERADO [OK]' : 'PENDIENTE'}`),
        "=================================================="
      ].join("\n");

      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = reportText;
      tempTextArea.style.position = 'fixed';
      tempTextArea.style.left = '-9999px';
      document.body.appendChild(tempTextArea);
      tempTextArea.select();

      try {
        document.execCommand('copy');
        sound.success();
        showModal(true, "¡Reporte copiado al portapapeles! Puedes pegarlo en tu entrega de Canvas, Eva o tarea de GitHub.");
      } catch (err) {
        showModal(false, "No se pudo copiar automáticamente. Puedes seleccionar el texto del certificado manualmente.");
      } finally {
        document.body.removeChild(tempTextArea);
      }
    }

    // ==================== MODAL (Sin alert) ====================
    function showModal(isSuccess, message) {
      const modal = document.getElementById('game-modal');
      const iconCont = document.getElementById('modal-icon-container');
      const title = document.getElementById('modal-title');
      const msg = document.getElementById('modal-message');

      if (isSuccess) {
        iconCont.className = 'w-16 h-16 rounded-full mx-auto flex items-center justify-center mb-4 text-3xl bg-utpl-yellow/20 text-utpl-yellow border border-utpl-yellow';
        iconCont.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
        title.textContent = '¡Completado!';
      } else {
        iconCont.className = 'w-16 h-16 rounded-full mx-auto flex items-center justify-center mb-4 text-3xl bg-amber-500/20 text-utpl-yellow border border-utpl-yellow/50';
        iconCont.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
        title.textContent = 'Aviso';
      }

      msg.textContent = message;
      modal.classList.remove('hidden');
    }

    function closeModal() {
      sound.click();
      document.getElementById('game-modal').classList.add('hidden');
    }
  </script>
</body>
